      ],
      "question": "Did the customer's payment pay_e2 eventually go through?",
      "must_include": [["yes", "succeeded", "went through"]],
      "must_not_include": ["never succeeded", "never went through"],
      "must_cite": ["msg_e2b"]
    },
    {
